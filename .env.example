PORT=8080
DATABASE_URL=sqlite:///data/receipts.db?mode=rwc
TER_UPSTREAM_BASE_URL=https://observe.internal.example
TER_ALLOWED_EXPORT_PATHS=/api/logs/export,/api/traces/export
TER_MAX_EXPORT_RANGE_HOURS=24
TER_MAX_EXPORT_ROWS=10000
TER_ALLOWED_REDACTION_POLICIES=pii-basic,strict
TER_IDENTITY_HEADER=x-export-user
TER_RECEIPT_SIGNING_KEY=replace-with-at-least-32-random-bytes
TER_SIGNING_KEY_FILE=/data/receipt-signing.key
TER_ADMIN_TOKEN=replace-with-at-least-32-random-bytes
TER_ADMIN_TOKEN_FILE=/data/admin-access.key
TER_BUILD_SHA=development
